{
  "name": "snaptium-workspace",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.17.0",
  "engines": { "node": ">=22.22.1 <23" },
  "scripts": {
    "dev:web": "pnpm --filter @snaptium/web dev",
    "build:web": "pnpm --filter @snaptium/web build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint apps/web packages tests/web vitest.config.ts eslint.config.mjs --max-warnings 0",
    "test": "vitest run",
    "test:editor": "vitest run tests/web/editor",
    "test:drafts": "vitest run tests/web/drafts",
    "test:identity": "vitest run tests/web/identity.test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:web"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "@eslint/js": "10.0.1",
    "@snaptium/contracts": "workspace:*",
    "@snaptium/editor": "workspace:*",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.4.6",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "29.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue": "3.5.43",
    "vue-tsc": "3.3.12"
  }
}
